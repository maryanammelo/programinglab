#include <string.h>
#include <stdio.h>

struct Aluno {
    char nome[50];
    int idade;
    float altura;
};

int main() {
    
   struct Aluno aluno1;
   strcpy(aluno1.nome, "Gabri");
   aluno1.idade = 21;
   aluno1.altura = 1.70;
   printf("Nome: %s\n", aluno1.nome);
   printf("Idade: %d\n", aluno1.idade);
   printf("Altura: %f\n", aluno1.altura);

    return 0;
}
